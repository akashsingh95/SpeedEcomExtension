{
  "manifest_version": 3,
  "name": "Myntra Payment Downloader by SpeedEcom",
  "version": "0.6.0",
  "description": "Bulk-download Myntra Partner Portal payment files for a chosen date range and Prepaid/Postpaid selection into a single ZIP, with retry and progress tracking. Requires a Speed Ecom account.",
  "permissions": ["storage", "downloads", "scripting", "declarativeNetRequest"],
  "host_permissions": [
    "https://partners.myntrainfo.com/*",
    "https://partnersapi.myntrainfo.com/*",
    "https://analyticsfereportci.blob.core.windows.net/*",
    "https://speedecomsolution.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SpeedEcom Myntra Payment Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://partners.myntrainfo.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
